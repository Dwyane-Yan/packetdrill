// Verify the Sashiko/v19 concern: offset > 0 while the active DSS mapping is
// out of order at the MPTCP level, with NON-CONTIGUOUS consecutive mappings.
//
// Timeline (DSN offsets relative to the peer IDSN, first data byte = 1):
//
//   MPC data sf0: TCP [1,3)  2B   implicit map, DSN [1,3)
//   S0  sf0: TCP [3,503) 500B  map A: dsn=3   ssn=3   dll=700 -> SSN [3,703)
//   S2  sf1: TCP [1,201) 200B  map  : dsn=503 ssn=1   dll=200 -> DSN [503,703)
//   S1  sf0: TCP [503,803) 300B map B: dsn=903 ssn=703 dll=100 -> SSN [703,803)
//            prefix SSN [503,703) belongs to map A, already delivered by S2
//            => discard 200B, install B, mapped DSN 903 > ack_seq 703 (OoO)
//   S3  sf1: TCP [201,401) 200B map  : dsn=703 ssn=201 dll=200 -> DSN [703,903)
//            the real data filling the DSN gap
//
// Correct receiver: S1 is OoO, waits for S3 to fill [703,903), then delivers
// S3 followed by S1's tail.  Total 1002 bytes.
//
// If mptcp_init_skb() labels the stale [0,offset) prefix as
// [mapped_dsn - offset, mapped_dsn) = [703,903) without pulling it, the msk
// advances ack_seq across the gap, delivers the stale prefix bytes and drops
// S3.  The captured stream differs from the correct one starting at index 702.
--tolerance_usecs=100000
`../common/defaults.sh`

+0    `../common/multi-ep.sh -e 0`
+0    `: > /dev/shm/mptcp_recv2.bin`

+0.0  socket(..., SOCK_STREAM, IPPROTO_MPTCP) = 3
+0.0  setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0.0  fcntl(3, F_GETFL) = 0x2 (flags O_RDWR)
+0.0  fcntl(3, F_SETFL, O_RDWR|O_NONBLOCK) = 0

+0    bind(3, ..., ...) = 0
+0    listen(3, 1) = 0

// MP_CAPABLE
+0.0    <  addr[caddr0] > addr[saddr0]  S   0:0(0)         win 65535  <mss 1460, nop, nop, sackOK, nop, wscale 8, mpcapable v1 flags[flag_h] nokey>
+0.0    >                               S.  0:0(0)  ack 1             <mss 1460, nop, nop, sackOK, nop, wscale 8, mpcapable v1 flags[flag_h] key[skey]>
+0.1    <                                .  1:1(0)  ack 1  win 256    <                                           mpcapable v1 flags[flag_h] key[ckey=2, skey]>
+0    accept(3, ..., ...) = 4

// MP_CAPABLE carrying 2 data bytes (DSN/SSN 1..3)
+0.0    <                               P.  1:3(2)  ack 1  win 256    <mpcapable v1 flags[flag_h] key[skey, ckey] mpcdatalen 2, nop, nop>
+0.0    >                                .  1:1(0)  ack 3             <dss dack8=3 dll=0 nocs>

// second subflow
+0.1    <  addr[caddr1] > addr[saddr0]  S   0:0(0)         win 65535  <mss 1460, nop, nop, sackOK, nop, wscale 8, mp_join_syn     address_id=1 token=sha256_32(skey)>
+0.0    >                               S.  0:0(0)  ack 1             <mss 1460, nop, nop, sackOK, nop, wscale 8, mp_join_syn_ack address_id=1 sender_hmac=auto>
+0.1    <                                .  1:1(0)  ack 1  win 256                                               <mp_join_ack                  sender_hmac=auto>
+0.0    >                                .  1:1(0)  ack 1             <dss dack8=3 nocs>

// S0 sf0: 500B, map A covers SSN [3,703)
+0.1    <  addr[caddr0] > addr[saddr0]  P.  3:503(500) ack 1  win 256  <dss dack8=1 dsn8=3 ssn=3 dll=700 nocs, nop, nop>
+0.0    >  addr[saddr0] > addr[caddr0]  .  1:1(0)  ack 503            <dss dack8=503 dll=0 nocs>

// S2 sf1: delivers the prefix DSN range [503,703)
+0.1    <  addr[caddr1] > addr[saddr0]  P.  1:201(200) ack 1  win 256  <dss dack8=1 dsn8=503 ssn=1 dll=200 nocs, nop, nop>
+0.0    >  addr[saddr0] > addr[caddr1]  .  1:1(0)  ack 201            <dss dack8=703 dll=0 nocs>

// S1 sf0: 300B, prefix 200B is duplicate, map B is OoO (DSN 903)
+0.1    <  addr[caddr0] > addr[saddr0]  P.  503:803(300) ack 1  win 256  <dss dack8=1 dsn8=903 ssn=703 dll=100 nocs, nop, nop>
+0.0    >  addr[saddr0] > addr[caddr0]  .  1:1(0)  ack 803            <dss dack8=703 dll=0 nocs>

// S3 sf1: the real data for the DSN gap [703,903)
+0.1    <  addr[caddr1] > addr[saddr0]  P.  201:401(200) ack 1  win 256  <dss dack8=1 dsn8=703 ssn=201 dll=200 nocs, nop, nop>
+0.0    >  addr[saddr0] > addr[caddr1]  .  1:1(0)  ack 401            <dss dack8=1003 dll=0 nocs>

// Capture 1002 delivered bytes (socket -> pipe -> file) and verify the
// stream byte-exactly. packetdrill fills every injected byte i with
// (relative_seq + i) & 0xff, so the expected stream is:
//   seq 1..2 (MPC) + 3..502 (S0) + 1..200 (S2) + 201..400 (S3) + 703..802
// Delivering the stale sf0 prefix 503..702 instead of S3 changes the md5.
+0.5  open("/dev/shm/mptcp_recv2.bin", O_WRONLY) = 7
+0    pipe([5, 6]) = 0
+0    splice(4, NULL, 6, NULL, 1002, 0) = 1002
+0    splice(5, NULL, 7, NULL, 1002, 0) = 1002
+0    close(7) = 0
+0    close(5) = 0
+0    close(6) = 0
+0    `test "$(md5sum < /dev/shm/mptcp_recv2.bin)" = "af14073928be9b054eab0dfb8ec9df17  -" || { echo "content mismatch: $(md5sum /dev/shm/mptcp_recv2.bin)"; exit 1; }`
