// Receive MPTFO + cookie but no data
--tolerance_usecs=100000
`../common/defaults.sh`

// A first connection to store the cookie
 0.0    socket(..., SOCK_STREAM, IPPROTO_MPTCP) = 3
+0.0    setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0.0    setsockopt(3, SOL_TCP, TCP_FASTOPEN, [2], 4) = 0

+0.0    bind(3, ..., ...) = 0
+0.0    listen(3, 1) = 0

// The Cookie has already been exchanged before, data can be exchanged, but
// intentionnaly not added to check if the kernel handles this case properly.
+0.1      <  S   0:0(0)                    win 65535  <mss 1460, sackOK, TS val 100 ecr 0,   nop, wscale 8, FO TFO_COOKIE, nop, nop, mpcapable v1 flags[flag_h] nokey>
+0.0      >  S.  0:0(0)          ack 1                <mss 1460, sackOK, TS val 100 ecr 100, nop, wscale 8,                          mpcapable v1 flags[flag_h] key[skey]>
+0.2      <   .  1:1(0)          ack 1     win 450    <                                                                              mpcapable v1 flags[flag_h] key[ckey, skey]>

+0.2    accept(3, ..., ...) = 4

// check the rest is OK
+0.0      <  P.  1:1001(1000)    ack 1     win 225            <nop, nop, TS val 100 ecr 100,                                         mpcapable v1 flags[flag_h] key[ckey, skey] mpcdatalen 1000, nop, nop>
+0.0      >   .  1:1(0)          ack 1001                     <nop, nop, TS val 100 ecr 100, dss dack8=1001 nocs>

+0.2    read(4, ..., 1000) = 1000

+0.2    close(4) = 0
+0.0      >   .  1:1(0)          ack 1001                     <nop, nop, TS val 100 ecr 100, dss dack8=1001 dsn8=1 ssn=0 dll=1 nocs fin, nop, nop>
